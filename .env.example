# ============ 通用配置 ============
APP_PORT=8080
APP_ENV=development

# ============ 数据库配置 (PostgreSQL) ============
DB_HOST=db
DB_PORT=5432
DB_NAME=myapp
DB_USER=app_user
DB_PASSWORD=your_secure_password

# PostgreSQL 容器初始化
POSTGRES_DB=myapp
POSTGRES_USER=app_user
POSTGRES_PASSWORD=your_secure_password

# ============ Redis ============
REDIS_HOST=redis
REDIS_PORT=6379

# ============ JWT ============
JWT_SECRET=your_jwt_secret